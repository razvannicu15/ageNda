<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="?attr/textAppearanceDisplaySmall"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/tagline"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- Permission -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_perm"
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_title"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/perm_text"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_perm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/perm_btn" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pin"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="@string/pin_btn" />

        <!-- Look -->
        <TextView style="@style/Section" android:text="@string/sec_look" />

        <TextView style="@style/Label" android:text="@string/theme" />
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/tg_theme"
            style="@style/Toggle">
            <Button android:id="@+id/th_auto" style="@style/ToggleBtn" android:text="@string/theme_auto" />
            <Button android:id="@+id/th_light" style="@style/ToggleBtn" android:text="@string/theme_light" />
            <Button android:id="@+id/th_dark" style="@style/ToggleBtn" android:text="@string/theme_dark" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView style="@style/Label" android:text="@string/colors" />
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/tg_colors"
            style="@style/Toggle">
            <Button android:id="@+id/co_dynamic" style="@style/ToggleBtn" android:text="@string/colors_dynamic" />
            <Button android:id="@+id/co_neutral" style="@style/ToggleBtn" android:text="@string/colors_neutral" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView style="@style/Label" android:text="@string/opacity" />
        <com.google.android.material.slider.Slider
            android:id="@+id/sl_opacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="5"
            android:value="90"
            android:valueFrom="30"
            android:valueTo="100"
            app:labelBehavior="floating" />

        <!-- Content -->
        <TextView style="@style/Section" android:text="@string/sec_content" />

        <TextView style="@style/Label" android:text="@string/days" />
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/tg_days"
            style="@style/Toggle">
            <Button android:id="@+id/d7" style="@style/ToggleBtn" android:text="7" />
            <Button android:id="@+id/d14" style="@style/ToggleBtn" android:text="14" />
            <Button android:id="@+id/d30" style="@style/ToggleBtn" android:text="30" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sw_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/show_location" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sw_countdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/show_countdown" />

        <!-- Calendars -->
        <TextView style="@style/Section" android:text="@string/sec_calendars" />
        <LinearLayout
            android:id="@+id/cal_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Language -->
        <TextView style="@style/Section" android:text="@string/sec_language" />
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/tg_lang"
            style="@style/Toggle">
            <Button android:id="@+id/la_auto" style="@style/ToggleBtn" android:text="@string/lang_auto" />
            <Button android:id="@+id/la_ro" style="@style/ToggleBtn" android:text="@string/lang_ro" />
            <Button android:id="@+id/la_en" style="@style/ToggleBtn" android:text="@string/lang_en" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</ScrollView>
