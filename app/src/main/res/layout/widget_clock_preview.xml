<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="8dp">

    <LinearLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- clock: tap → alarms -->
        <LinearLayout
            android:id="@+id/clock_block"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/clock_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:letterSpacing="-0.03"
                android:textColor="#FFFFFFFF"
                android:textSize="64dp"
                android:shadowColor="#40000000" android:shadowDy="1" android:shadowRadius="4" />

            <TextClock
                android:id="@+id/clock_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:format12Hour="EEEE, d MMMM"
                android:format24Hour="EEEE, d MMMM"
                android:maxLines="1"
                android:textColor="#E6FFFFFF"
                android:textSize="16dp"
                android:shadowColor="#40000000" android:shadowDy="1" android:shadowRadius="4" />
        </LinearLayout>

        <!-- weather: tap → weather app -->
        <LinearLayout
            android:id="@+id/wx_block"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="end"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/wx_icon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/wx_rain"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/wx_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false"
                    android:text="5°"
                    android:textColor="#FFFFFFFF"
                    android:textSize="36dp"
                    android:shadowColor="#40000000" android:shadowDy="1" android:shadowRadius="4" />
            </LinearLayout>

            <TextView
                android:id="@+id/wx_cond"
                android:text="Ploaie slabă"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="15dp"
                android:shadowColor="#40000000" android:shadowDy="1" android:shadowRadius="4" />

            <TextView
                android:id="@+id/wx_hilo"
                android:text="↑7° ↓-2° · Florești"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#CCFFFFFF"
                android:textSize="14dp"
                android:shadowColor="#40000000" android:shadowDy="1" android:shadowRadius="4" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="24dp"
        android:background="@drawable/widget_mask"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_bg"
            android:tint="#FF1C1C1E"
            android:importantForAccessibility="no" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="6dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="58dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="20dp" android:paddingEnd="20dp">
                <TextView android:layout_width="68dp" android:layout_height="wrap_content" android:text="MÂINE" android:textColor="#B3FFFFFF" android:textSize="12.5dp" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="Deșeuri menajere" android:textColor="#FFFFFFFF" android:textSize="17dp" />
                <ImageView android:layout_width="11dp" android:layout_height="11dp" android:src="@drawable/dot" android:tint="#C9A7F5" />
            </LinearLayout>
            <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="98dp" android:layout_marginEnd="20dp" android:src="@drawable/line" android:scaleType="fitXY" android:tint="#1FFFFFFF" />
        </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="58dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="20dp" android:paddingEnd="20dp">
                <TextView android:layout_width="68dp" android:layout_height="wrap_content" android:text="MAR.&#10;24 NOV." android:textColor="#B3FFFFFF" android:textSize="12.5dp" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="Hârtie, Carton" android:textColor="#FFFFFFFF" android:textSize="17dp" />
                <ImageView android:layout_width="11dp" android:layout_height="11dp" android:src="@drawable/dot" android:tint="#C9A7F5" />
            </LinearLayout>
            <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="98dp" android:layout_marginEnd="20dp" android:src="@drawable/line" android:scaleType="fitXY" android:tint="#1FFFFFFF" />
        </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="58dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="20dp" android:paddingEnd="20dp">
                <TextView android:layout_width="68dp" android:layout_height="wrap_content" android:text="VIN.&#10;27 NOV." android:textColor="#B3FFFFFF" android:textSize="12.5dp" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="Citire curent Luna" android:textColor="#FFFFFFFF" android:textSize="17dp" />
                <ImageView android:layout_width="11dp" android:layout_height="11dp" android:src="@drawable/dot" android:tint="#7BC96F" />
            </LinearLayout>
            <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="98dp" android:layout_marginEnd="20dp" android:src="@drawable/line" android:scaleType="fitXY" android:tint="#1FFFFFFF" />
        </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
