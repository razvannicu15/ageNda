<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <!-- weather (tap → weather app) -->
        <LinearLayout
            android:id="@+id/wx_block"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/wx_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:text="—"
                android:textColor="#FFFFFFFF"
                android:textSize="58sp"
                android:shadowColor="#73000000" android:shadowDy="1" android:shadowRadius="6" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/wx_pin"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:alpha="0.85"
                    android:src="@drawable/ic_pin"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/wx_place"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:alpha="0.85"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp"
                    android:shadowColor="#73000000" android:shadowDy="1" android:shadowRadius="6" />
            </LinearLayout>

            <TextView
                android:id="@+id/wx_cond"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:shadowColor="#73000000" android:shadowDy="1" android:shadowRadius="6" />

            <TextView
                android:id="@+id/wx_hilo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:shadowColor="#73000000" android:shadowDy="1" android:shadowRadius="6" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/wx_icon"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginEnd="-4dp"
                android:src="@drawable/wx_partly_day"
                android:importantForAccessibility="no" />

            <!-- clock (tap → alarms) -->
            <LinearLayout
                android:id="@+id/clock_block"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="end"
                android:orientation="vertical">

                <TextClock
                    android:id="@+id/clock_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="EEE, d MMMM"
                    android:format24Hour="EEE, d MMMM"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:shadowColor="#73000000" android:shadowDy="1" android:shadowRadius="6" />

                <TextClock
                    android:id="@+id/clock_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-6dp"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:textColor="#FFFFFFFF"
                    android:textSize="66sp"
                    android:shadowColor="#73000000" android:shadowDy="1" android:shadowRadius="6" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout     android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="18dp"
        android:background="@drawable/widget_mask"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_bg"
            android:tint="#FF1C1C1E"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:id="@+id/ic_cal"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_calendar"
                    android:tint="#FFFFFFFF"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/weekday"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="17sp" />

                <ImageView
                    android:id="@+id/btn_add"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="11dp"
                    android:src="@drawable/ic_add"
                    android:tint="#FFFFFFFF"
                    android:contentDescription="+" />

                <ImageView
                    android:id="@+id/btn_refresh"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_refresh"
                    android:tint="#FFFFFFFF"
                    android:contentDescription="⟳" />
            </LinearLayout>

            <ImageView
                android:id="@+id/header_line"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:scaleType="fitXY"
                android:src="@drawable/line"
                android:tint="#22FFFFFF"
                android:importantForAccessibility="no" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ListView
                    android:id="@+id/list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:divider="@null"
                    android:dividerHeight="0dp"
                    android:paddingBottom="10dp"
                    android:scrollbars="none" />

                <TextView
                    android:id="@+id/empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="16dp"
                    android:textColor="#FF8E8E93"
                    android:textSize="14sp" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
